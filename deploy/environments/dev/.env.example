# =====================================================
# Development Environment Configuration — TEMPLATE
# =====================================================
# Local Docker Desktop only.
# Infrastructure: PostgreSQL + Redis + Kafka (KRaft) run as local containers.
# Kong Gateway: API 流量通过 Kong 统一代理。
#
# First-time setup:
#   copy .env.example .env
# Then replace every CHANGE_ME_* placeholder below with a real value obtained through
# a secure internal channel (secrets manager / team lead) — NEVER commit the filled-in
# .env (it is already in .gitignore).
# =====================================================

# Database
POSTGRES_PORT=5432
POSTGRES_DB=workflow_platform_dev
POSTGRES_USER=platform_dev
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# When DBeaver uses host PostgreSQL (localhost:5432) and backends in Docker should use the same DB,
# uncomment below so backends connect to host.docker.internal instead of the compose postgres service.
# POSTGRES_HOST=host.docker.internal

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET_256_BIT
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Encryption
ENCRYPTION_SECRET_KEY=CHANGE_ME_32_BYTE_AES_256_KEY

# Backend Ports
WORKFLOW_ENGINE_PORT=8081
ADMIN_CENTER_PORT=8090
USER_PORTAL_PORT=8082
DEVELOPER_WORKSTATION_PORT=8083

# Frontend Ports
ADMIN_CENTER_FRONTEND_PORT=3100
USER_PORTAL_FRONTEND_PORT=3101
DEVELOPER_WORKSTATION_FRONTEND_PORT=3102
PLATFORM_LOGIN_FRONTEND_PORT=3110
PLATFORM_HELP_FRONTEND_PORT=3111

# Edge Nginx (single-origin multi-path dev entry)
EDGE_FRONTEND_PORT=3000

# SSO（统一 /login 与 /internal/sso/redeem；须与 admin / portal / developer 容器一致）
SSO_INTERNAL_TOKEN=CHANGE_ME_SSO_INTERNAL_TOKEN
# 内部 API 共享密钥：admin-center ↔ user-portal（/internal/*），须与两边配置一致
PORTAL_INTERNAL_API_TOKEN=CHANGE_ME_PORTAL_INTERNAL_API_TOKEN
# admin-center 调用 user-portal 内部 API 的基址（含 context-path /api/portal）
USER_PORTAL_BASE_URL=http://user-portal:8080/api/portal
# C-3 (DECISIONS.md#d6): 可信服务密钥；admin-center/DW/portal 共享，AP 不得持有。
SERVICE_INTERNAL_TOKEN=CHANGE_ME_SERVICE_INTERNAL_TOKEN
# 浏览器回跳地址前缀：须与 Vite base 一致。日常请用边缘入口（单源），与 EDGE_FRONTEND_PORT 对齐。
SSO_REDIRECT_ADMIN_PREFIX=http://localhost:3000/admin/sso/callback
SSO_REDIRECT_ADMIN_HTTP_PREFIX=http://localhost:3000/admin/sso/callback
SSO_REDIRECT_PORTAL_PREFIX=http://localhost:3000/portal/sso/callback
SSO_REDIRECT_PORTAL_HTTP_PREFIX=http://localhost:3000/portal/sso/callback
SSO_REDIRECT_DW_PREFIX=http://localhost:3000/dev/sso/callback
SSO_REDIRECT_DW_HTTP_PREFIX=http://localhost:3000/dev/sso/callback

# Kong Gateway
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:3101,http://127.0.0.1:3101,http://localhost:3102,http://127.0.0.1:3102,http://localhost:3110,http://127.0.0.1:3110,http://localhost:5173,http://127.0.0.1:5173

# Kafka
KAFKA_PORT=19092
KAFKA_INTERNAL_PORT=29092

# Features
SWAGGER_ENABLED=true

# Database Initialization
DB_INIT_MODE=full-test

# Superset
# Flask SECRET_KEY + guest-token signing secret. DEV value only — prod injects via k8s Secret.
# Never the literal "replace_this_..." placeholder (forgeable guest tokens).
SUPERSET_SECRET_KEY=CHANGE_ME_SUPERSET_SECRET_KEY
# Metadata DB URI — required (fail-closed). No hardcoded fallback in superset_config.py.
# Local compose injects from this .env; K8s injects via Secret (SUPERSET_DATABASE_URI).
SUPERSET_DATABASE_URI=postgresql+psycopg2://platform_dev:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/workflow_platform_dev
# Origins allowed to call Superset APIs (CORS) and to iframe it (CSP frame-ancestors).
# DEV: the user-portal is reached via the edge on :3000.
SUPERSET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Internal Superset URL used by backend containers.
# Internal Superset base for admin-center REST calls (login / csrf / guest_token).
# Must carry SUPERSET_APP_ROOT: Superset 6.0 mounts the whole app (API included) under it,
# so without /bi every /api/v1/... call 404s and no guest token can be minted.
SUPERSET_HOST=http://superset-final:8088/bi
# Browser-facing Superset base URL for embedded dashboards. Single-FQDN + path: the
# /bi subpath on the shared edge origin (author UI + embed both under /bi now; the old
# dedicated :8087/:8089 ports are retired). Raw :8088 stays closed.
SUPERSET_PUBLIC_HOST=http://localhost:3000/bi
# Superset subpath on the shared FQDN (edge forwards /bi/* unchanged).
SUPERSET_APP_ROOT=/bi
# PostgreSQL schema where Superset metadata tables live (dashboards, ab_role, etc.).
# Must be a safe identifier; search_path is appended by superset_config.py when missing.
SUPERSET_DB_SCHEMA=superset
# Superset admin/service account the BI module uses to mint guest tokens.
# Actual env vars consumed (application.yml: bi.superset.admin-username/-password):
# Superset service account used to mint guest tokens. It is a Superset DB user (provider=db),
# NOT a platform user, and `superset init` does not create it — after the first DB init run:
#   docker exec platform-superset-dev superset fab create-admin --username <BI_SUPERSET_USERNAME> \
#     --firstname BI --lastname ServiceAccount --email <any> --password <BI_SUPERSET_PASSWORD>
BI_SUPERSET_USERNAME=CHANGE_ME_SUPERSET_ADMIN_USERNAME
BI_SUPERSET_PASSWORD=CHANGE_ME_SUPERSET_ADMIN_PASSWORD
SUPERSET_BASE_IMAGE=CHANGE_ME_SUPERSET_BASE_IMAGE
# ==================== Activepieces (community + gateway shared account) ====================
# AP has NO host port: the only browser entry is the edge gateway :8085 (shared-account
# login bridge). In-network AP is reachable as activepieces:80.
ACTIVEPIECES_GATEWAY_PORT=8085
# AP-generated links (frontend/webhook) must point at the :8085 gateway, not the container.
ACTIVEPIECES_FRONTEND_URL=http://localhost:8085/
ACTIVEPIECES_WEBHOOK_URL=http://localhost:8085/
# Encryption + JWT secrets. AP 0.84 REQUIRES AP_ENCRYPTION_KEY to be a 32-char hex
# string (16 bytes) — generate with `openssl rand -hex 16`. It encrypts app-connection
# secrets only (NOT user passwords, which are bcrypt-hashed), so the shared account still
# signs in if this changes. Prod injects fresh secrets via k8s Secret.
ACTIVEPIECES_ENCRYPTION_KEY=CHANGE_ME_AP_ENCRYPTION_KEY_32_HEX_CHARS
ACTIVEPIECES_JWT_SECRET=CHANGE_ME_AP_JWT_SECRET
# Login bridge: non-prod ON so the gateway can mint AP tokens; prod runtime leaves OFF.
ACTIVEPIECES_BRIDGE_ENABLED=true
ACTIVEPIECES_INTERNAL_URL=http://activepieces:80
# AP bootstrap owner (platformRole=ADMIN). PROVISIONING ONLY — used by build-and-deploy.ps1
# (ap-bootstrap-shared-account.js + the one-off POST /v1/signing-keys) to create the AP
# platform/project and issue the signing key. admin-center NO LONGER signs in with it:
# every AP call is made as the real operator via managed-authn (per-user external token).
ACTIVEPIECES_SHARED_EMAIL=CHANGE_ME_AP_SHARED_EMAIL
ACTIVEPIECES_SHARED_PASSWORD=CHANGE_ME_AP_SHARED_PASSWORD
# ==================== LDAP / SSO-DSP (real corporate config) ====================
# 本地直连企业 LDAP；敏感密钥放同目录 secrets.env，由 build-and-deploy.ps1 自动带入。
LDAP_ENABLED=true
DSP_SSO_ENABLED=false
# 开发跳过 Admin Center 角色校验（任意 ACTIVE 用户可登录联调）；生产严禁开启：
ADMIN_DEV_BYPASS_ROLE_CHECK=true
# --- Corporate LDAP / AD ---
LDAP_PROVIDER_URL=CHANGE_ME_LDAP_PROVIDER_URL
LDAP_BASE_DN=CHANGE_ME_LDAP_BASE_DN
LDAP_BIND_DN=CHANGE_ME_LDAP_BIND_DN
LDAP_BIND_PASSWORD=CHANGE_ME_IN_SECRETS_ENV
LDAP_TLS=true
LDAP_CONNECT_TIMEOUT_MS=10000
LDAP_READ_TIMEOUT_MS=60000
LDAP_PAGE_SIZE=500
LDAP_MAX_ENTRIES=0
LDAP_USER_SEARCH_FILTER=(|(objectclass=userproxy)(objectclass=user))
LDAP_SYNC_ENABLED=true
LDAP_SYNC_CRON=0 0 */2 * * ?
LDAP_KEYSTORE_PATH=/app/ldap-prod.jks
LDAP_KEYSTORE_PASSWORD=CHANGE_ME_LDAP_KEYSTORE_PASSWORD
LDAP_ATTR_EMPLOYEE_ID=employeeID
LDAP_ATTR_UID=uid
LDAP_ATTR_SAM_ACCOUNT_NAME=hsbc-ad-SAMAccountName
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_MAIL=mail
LDAP_ATTR_TELEPHONE=telephoneNumber
LDAP_ATTR_TITLE=title
LDAP_ATTR_WORK_ROLE=hsbc-ad-WorkRole
LDAP_ATTR_LINE_MANAGER_ID=hsbc-ad-LineManagerID
# --- Hermes AD group sync ---
LDAP_HERMES_ENV=DEV
LDAP_GROUP_SEARCH_BASE_DN=CHANGE_ME_LDAP_GROUP_SEARCH_BASE_DN
LDAP_HERMES_GROUP_SYNC_GROUPS=Admin=Infodir-Hermes-Default-DEV-Admin,User=Infodir-Hermes-Default-DEV-User,Developer=Infodir-Hermes-Default-DEV-Developer
LDAP_HERMES_GROUP_SYNC_ROLES=Admin,User,Developer
LDAP_HERMES_GROUP_SYNC_PATTERN=Infodir-Hermes-Default-{env}-{role}
LDAP_HERMES_GROUP_SYNC_BATCH_SIZE=20
# --- DSP / SSO ---
DSP_AUTHENTICATE_URL=CHANGE_ME_DSP_AUTHENTICATE_URL
DSP_TRANSLATOR_URL=CHANGE_ME_DSP_TRANSLATOR_URL
DSP_CLIENT_ID=CHANGE_ME_DSP_CLIENT_ID
DSP_CLIENT_SECRET=CHANGE_ME_IF_DSP_IS_ENABLED
DSP_EMPLOYEE_ID_CLAIMS=employeeID,employeeId,emplid,staffId,user.employeeId,sub
DSP_USERNAME_CLAIMS=uid,username,preferred_username,cn,sAMAccountName,hsbc-ad-SAMAccountName,sub
# ==================== SMTP / SSRF (Developer Workstation connection test) ====================
# Comma-separated hostnames allowed to resolve to private IPs (add your corp SMTP relay here).
SSRF_ALLOWED_HOSTS=activepieces

# Activepieces sandbox egress allow-list (AP_NETWORK_MODE=STRICT). Comma-separated
# hostnames, IPs or CIDRs; hostnames are resolved at worker start-up (HERMES-PATCH in
# packages/server/worker/src/lib/egress/lifecycle.ts).
# Needed so an AP flow can fetch platform-hosted files handed to it by the engine
# (FILE_SERVICE_BASE_URL -> developer-workstation:8080); without it the sandbox gets
# "403 Egress blocked" and the flow fails at its HTTP step.
# Keep this to the hosts flows actually need — a CIDR here opens the whole compose
# network to any HTTP step a flow author writes.
AP_SSRF_ALLOW_LIST=developer-workstation

# L7 per-user provisioning（审计到人）：signing key 由 POST /v1/signing-keys 一次性生成（dev 专用密钥）
ACTIVEPIECES_MANAGED_SIGNING_KEY_ID=CHANGE_ME_AP_SIGNING_KEY_ID
ACTIVEPIECES_MANAGED_PRIVATE_KEY=CHANGE_ME_AP_MANAGED_PRIVATE_KEY_PEM
# 共享 project 的外部 id：已 stamp 到存量 flow 所在的原共享账号 project（避免新旧两个 project 分家）
ACTIVEPIECES_MANAGED_PROJECT_EXTERNAL_ID=hermes-main

#AI Platform
GROUP_AI_PLATFORM_GPT_54_NANO=CHANGE_ME_AI_GATEWAY_URL

# DW 的 AI Generate 直连上面的 gateway（OpenAI 兼容 chat/completions）。
# 凭证不在这里：走的是每用户的 DSP AMToken，由浏览器经 X-AM-Token 头透传，后端不持有共享密钥。
# 留空则 AI Generate 每轮以 AI_GATEWAY_NOT_CONFIGURED 显式失败（本机没有内网可达性，属预期）。
AI_GATEWAY_URL=CHANGE_ME_AI_GATEWAY_URL
# 空 => 不在 body 里发 model 字段（URL 路径已经选定了模型）。
AI_GATEWAY_MODEL=
# 该 FQDN 若在内网解析到私网地址，须加进 SSRF_ALLOWED_HOSTS，否则 DW 启动时校验直接拒绝：
# SSRF_ALLOWED_HOSTS=activepieces,gaip-api-uat.hsbc-12152296-gaipuat-dev.dev.gcp.cloud.hk.hsbc
