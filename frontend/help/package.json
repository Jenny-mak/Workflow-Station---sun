{
  "name": "platform-help",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test src/utils/helpCodeSnippet.test.ts src/utils/helpInlineLink.test.ts src/formCtlShapeSample.test.ts src/formCtlWhatBody.test.ts src/utils/helpSearch.test.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "vue": "3.5.32",
    "vue-i18n": "11.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.9.1",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "5.4.21",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "glob": "12.0.0",
    "rollup": "4.60.1"
  },
  "pnpm": {
    "overrides": {
      "vscode-uri": "3.1.0",
      "picomatch": "4.0.4",
      "@typescript-eslint/types": "8.59.2",
      "@typescript-eslint/tsconfig-utils": "8.59.2"
    }
  }
}
